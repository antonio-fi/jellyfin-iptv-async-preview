# Example only. Edit all paths, user, group, host, origin and playlist.
# Restrict ports 8099/8100 from untrusted networks before enabling.
[Unit]
Description=ZAPPING IPTV thumbnail preview (experimental)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zapping
Group=zapping
WorkingDirectory=/opt/zapping
ExecStart=/opt/zapping/.venv/bin/python /opt/zapping/src/gestore_iptv.py --host 192.168.1.20 --origin http://192.168.1.20:8096 --playlist /private/path/channels.m3u8 --ffmpeg ffmpeg
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
